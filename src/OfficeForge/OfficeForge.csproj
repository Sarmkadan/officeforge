<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>OfficeForge</PackageId>
    <Description>Cross-platform Word/Excel/PowerPoint document creation and editing built on the OpenXML SDK.</Description>
