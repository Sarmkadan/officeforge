<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>OfficeForge</PackageId>
    <Version>0.1.0</Version>
    <Authors>Vladyslav Zaiets</Authors>
    <Company>Vladyslav Zaiets</Company>
    <Description>Cross-platform Word/Excel/PowerPoint document creation and editing built on the OpenXML SDK. No Microsoft Office, no COM interop.</Description>
    <PackageTags>openxml;docx;xlsx;pptx;office;cross-platform</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Sarmkadan/officeforge</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Sarmkadan/officeforge</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
